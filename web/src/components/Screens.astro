---
/** The app, screen by screen: real screenshots, each with what you're looking at. */
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const screens = [
  {
    file: "agent",
    width: 980,
    height: 784,
    eyebrow: "The agent",
    title: "Ask in words. Watch it happen.",
    text: "The chat lives in the sidebar. The agent reads the song and the style’s maps before it touches anything, then every step it takes is listed: what it read, what it edited, what it auditioned, what it asked you to pick. A whole request is one undo.",
    alt: "The Agent tab: a request to make the stab darker, the agent's steps (read the song, song maps, edit, audition, offer a choice, check the mix) and its answer, beside the playlist",
  },
  {
    file: "mixer",
    width: 1543,
    height: 784,
    eyebrow: "The mixer",
    title: "Inserts, effects, sends, meters.",
    text: "Every channel feeds a mixer insert with an effect chain, a fader, pan and sends, all ending at master. Effects can be GrooveKit’s own, like Echo and Chamber here, or your VST3 and AU plugins. The agent uses the same strips by name.",
    alt: "The mixer with Master, Drums, Stab, Pad and Space inserts, the Stab insert's Echo effect and its send to Space",
  },
  {
    file: "piano",
    width: 1543,
    height: 784,
    eyebrow: "The piano roll",
    title: "Notes you can see and move.",
    text: "Draw, stretch and transpose notes, shape velocities, quantize. The same notes show in the channel rack as steps, so a beat can grow into a melody. When the agent writes a stab line in the style’s figures, this is where it lands.",
    alt: "The piano roll with the stab pattern: a hammered note with jumps up a fourth, and a velocity lane below",
  },
];
---

<section id="screens" class="scroll-mt-16 border-t border-line py-24 sm:py-32">
  <div class="container-site">
    <div class="max-w-3xl">
      <p class="eyebrow">The app</p>
      <h2 class="title mt-4">A real studio, with the agent in the room.</h2>
      <p class="mt-6 text-lg leading-relaxed text-dim">
        Channels and patterns, a playlist of clips, a mixer, a piano roll, a sample browser with
        your library and GrooveKit’s presets. Everything the agent does, you can do by hand, and
        the other way round.
      </p>
    </div>

    <div class="mt-16 space-y-20 sm:space-y-28">
      {screens.map((s, i) => (
        <figure class:list={["grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12"]}>
          <div class:list={["lg:col-span-4", i % 2 === 1 && "lg:order-2"]}>
            <p class="eyebrow">{s.eyebrow}</p>
            <h3 class="mt-3 text-[clamp(1.5rem,3vw,2.1rem)] leading-[1.1] font-semibold tracking-[-0.03em] text-balance">{s.title}</h3>
            <figcaption class="mt-4 leading-relaxed text-dim">{s.text}</figcaption>
          </div>
          <a href={`${base}shots/${s.file}.jpg`} class:list={["block lg:col-span-8", i % 2 === 1 && "lg:order-1"]}>
            <div class="overflow-hidden rounded-xl bg-[#111113] shadow-[0_30px_80px_-30px_rgb(0_0_0/0.8),0_0_0_1px_rgb(255_255_255/0.08)]">
              <img src={`${base}shots/${s.file}.jpg`} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" class="block h-auto w-full" />
            </div>
          </a>
        </figure>
      ))}

      <!-- Listening: the song map, top and the figures, side by side. -->
      <figure class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <p class="eyebrow">Listening</p>
          <h3 class="mt-3 text-[clamp(1.5rem,3vw,2.1rem)] leading-[1.1] font-semibold tracking-[-0.03em] text-balance">It learns the style from the tracks you love.</h3>
          <figcaption class="mt-4 leading-relaxed text-dim">
            Put reference tracks in a folder per style. GrooveKit hears each one once, on your Mac,
            into a song map: tempo and swing, the parts against the mix, the spectrum, the kick and
            rumble measured, the arrangement bar by bar, and the figures the music and the bass
            play, as notes. The agent builds from the maps, so a hard techno stab hammers like the
            references do, and picks kicks that measure like theirs.
          </figcaption>
        </div>
        <div class="grid grid-cols-2 gap-4 lg:col-span-8">
          {["map", "map-figures"].map((f, i) => (
            <a href={`${base}shots/${f}.jpg`} class="block">
              <div class="overflow-hidden rounded-xl bg-[#111113] shadow-[0_30px_80px_-30px_rgb(0_0_0/0.8),0_0_0_1px_rgb(255_255_255/0.08)]">
                <img
                  src={`${base}shots/${f}.jpg`}
                  alt={i === 0 ? "A song map: tempo, swing, loudness, parts against the mix, spectral balance, the kick and rumble measured, and the arrangement" : "The same map's figures: two-bar piano rolls of what the music plays in the drop, in E minor"}
                  width="522"
                  height="676"
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full"
                />
              </div>
            </a>
          ))}
        </div>
      </figure>
    </div>
  </div>
</section>
