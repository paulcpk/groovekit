---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
/**
 * Page shell: metadata, the self-hosted font (no requests to Google), the site CSS, header and
 * footer. Canonical and social URLs only when SITE_URL is set at build time (astro.config.mjs).
 */
import "@fontsource-variable/inter";
import "../styles/site.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { NAME } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** The header's section links; the landing page's by default. */
  nav?: [id: string, label: string][];
}
const { title, description, nav } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="theme-color" content="#111113" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-lg bg-accent px-4 py-2 font-semibold text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header nav={nav} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
