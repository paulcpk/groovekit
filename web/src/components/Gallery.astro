---
/** GrooveKit's own instruments and effects, each linking to its full-size window. */
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const shots = [
  {
    file: "quartet",
    width: 2000,
    height: 1432,
    name: "Quartet",
    text: "Four-operator FM with eight algorithms, a chord memory and an analogue layer, on a panel with its own keyboard. 52 presets: house chords, techno stabs, keys, basses, leads.",
  },
  {
    file: "sextet",
    width: 2240,
    height: 1960,
    name: "Sextet",
    text: "Six morphing oscillators with FM, ring and sync, two filters, three envelopes, three LFOs and a modulation matrix. 51 presets for pads, drones, long chords and raw basslines.",
  },
  {
    file: "chamber",
    width: 1640,
    height: 1040,
    name: "Chamber",
    text: "An algorithmic reverb from a small room to a frozen hall, played from an X/Y pad you assign any two parameters to. 32 presets.",
  },
  {
    file: "echo",
    width: 1640,
    height: 1040,
    name: "Echo",
    text: "A stereo, ping-pong and dual delay with filtering, drive and modulation, tempo-synced, with the same pad. 35 presets.",
  },
  {
    file: "triad",
    width: 1880,
    height: 1400,
    name: "Triad",
    text: "Three oscillators with FM and ring modulation, unison, a filter with its own envelope, an LFO and glide. Presets from sub bass to chord stabs.",
  },
  {
    file: "multiband",
    width: 1340,
    height: 896,
    name: "Multiband compressor",
    text: "Three or four bands, each with its waveform scrolling past. Drag the crossovers and thresholds, band by band.",
  },
];
---

<section id="gallery" class="scroll-mt-16 border-t border-line py-24 sm:py-32">
  <div class="container-site">
    <div class="max-w-3xl">
      <p class="eyebrow">Instruments & effects</p>
      <h2 class="title mt-4">Synths and effects of its own.</h2>
      <p class="mt-6 text-lg leading-relaxed text-dim">
        Five VST3s come with GrooveKit, next to the built-in EQ, compressors, limiter, exciter,
        bitcrusher and stereo field. Every one draws what it does as it happens, each comes with
        presets, and the agent picks them by name: “Stabs: Hard Techno Stab”.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-2">
      {shots.map((s) => (
        <figure class="flex flex-col overflow-hidden rounded-2xl bg-panel ring-1 ring-line">
          <a href={`${base}gallery/${s.file}.jpg`} class="grid aspect-[4/3] place-items-center bg-bg p-3">
            <img
              src={`${base}gallery/${s.file}.jpg`}
              alt={`${s.name} in GrooveKit`}
              width={s.width}
              height={s.height}
              loading="lazy"
              decoding="async"
              class="block max-h-full w-auto max-w-full rounded-md"
            />
          </a>
          <figcaption class="p-6 sm:p-7">
            <h3 class="text-lg font-semibold tracking-[-0.015em]">{s.name}</h3>
            <p class="mt-2 max-w-2xl leading-relaxed text-dim">{s.text}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
