---
import { LINKS } from "../lib/site";
import AppWindow from "./AppWindow.astro";
import Icon from "./Icon.astro";
---

<section class="relative isolate overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28">
  <!-- Glow: warm from the studio, violet from the agent. -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-[-14rem] left-1/2 h-[36rem] w-[64rem] max-w-[160vw] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgb(242_163_58/0.16),transparent)]"></div>
    <div class="absolute top-[10rem] left-[62%] h-[28rem] w-[40rem] max-w-[120vw] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgb(167_139_250/0.12),transparent)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgb(255_255_255/0.025)_1px,transparent_1px),linear-gradient(to_bottom,rgb(255_255_255/0.025)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_at_top,black_20%,transparent_70%)] bg-[size:48px_48px]"></div>
  </div>

  <div class="container-site text-center">
    <a
      href={LINKS.github}
      class="gk-in inline-flex items-center gap-2 rounded-full bg-raised/80 py-1 pr-3 pl-1 text-xs font-medium text-dim ring-1 ring-line transition-colors hover:text-fg"
    >
      <span class="rounded-full bg-agent/15 px-2 py-0.5 text-agent">Open source</span>
      Early development<span class="hidden sm:inline"> · AGPLv3</span>
      <Icon name="arrow" class="size-3" />
    </a>

    <h1
      class="gk-in mx-auto mt-7 max-w-4xl text-[clamp(2.6rem,8vw,5.25rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance"
      style="--d:1"
    >
      You direct.
      <!-- Padding below, so the gradient reaches the descenders (the g), which it otherwise clips. -->
      <span class="-mb-[0.14em] block bg-gradient-to-r from-agent via-[#c4a8ff] to-accent bg-clip-text pb-[0.14em] text-transparent">
        The agent produces.
      </span>
    </h1>

    <p class="gk-in mx-auto mt-7 max-w-2xl text-[clamp(1.05rem,2.2vw,1.25rem)] leading-relaxed text-dim" style="--d:2">
      GrooveKit is an agent-first music production app for macOS. Ask Claude in the sidebar chat
      or from Claude Code: it arranges, mixes, automates and masters through the same API as the
      interface — every change shows up live in your window, and one undo takes it back.
    </p>

    <div class="gk-in mt-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center" style="--d:3">
      <a href={LINKS.download} class="btn btn-primary px-6 py-3.5">
        <Icon name="apple" class="size-[18px] -mt-0.5" />
        Download for macOS
      </a>
      <a href={LINKS.github} class="btn btn-secondary px-6 py-3.5">
        <Icon name="github" class="size-[18px]" />
        View on GitHub
      </a>
    </div>

    <p class="gk-in mt-5 text-[13px] text-faint" style="--d:4">
      Free · Apple silicon · macOS 12 or later ·{" "}
      <a href={LINKS.releases} class="text-dim underline decoration-line underline-offset-4 hover:text-fg">All releases</a>
    </p>
    <p class="gk-in mt-2 text-[13px] text-faint" style="--d:4">
      First launch: macOS asks you to confirm it once, under{" "}
      <a href="#faq" class="text-dim underline decoration-line underline-offset-4 hover:text-fg">Privacy &amp; Security</a>.
    </p>
  </div>

  <div class="container-site mt-16 sm:mt-20">
    <div class="gk-in mx-auto max-w-5xl" style="--d:5">
      <AppWindow />
    </div>
  </div>
</section>
