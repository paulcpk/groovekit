---
/** The app icon (four pads: one lit by you, one by the agent) plus the name. */
interface Props {
  class?: string;
  /** Show the word mark next to the icon. */
  word?: boolean;
}
const { class: className = "", word = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <img src={`${base}/logo.svg`} alt="" width="28" height="28" class="size-7 shrink-0" />
  {word && <span class="text-[17px] font-semibold tracking-[-0.02em]">GrooveKit</span>}
</span>
