{
  "schemaVersion": 1,
  "name": "Effect automation",
  "tempo": 120,
  "channels": [
    {
      "id": "beep", "insert": "filtered",
      "instrument": { "type": "sampler", "layers": [{ "id": "l", "sample": "../../fixtures/samples/beep.wav", "pitchTracking": false }] }
    }
  ],
  "patterns": [
    {
      "id": "p",
      "notes": [
        { "channel": "beep", "start": 0, "length": 240, "velocity": 127 },
        { "channel": "beep", "start": 1920, "length": 240, "velocity": 127 }
      ]
    }
  ],
  "playlist": {
    "tracks": [{ "id": "notes" }, { "id": "auto" }],
    "clips": [
      { "type": "pattern", "id": "c", "track": "notes", "start": 0, "length": 3840, "pattern": "p" },
      {
        "type": "automation", "id": "closed", "track": "auto", "start": 0, "length": 960,
        "target": { "scope": "effect", "insert": "filtered", "effect": "lp", "param": "frequency" },
        "points": [{ "time": 0, "value": 100 }]
      },
      {
        "type": "automation", "id": "open", "track": "auto", "start": 1920, "length": 960,
        "target": { "scope": "effect", "insert": "filtered", "effect": "lp", "param": "frequency" },
        "points": [{ "time": 0, "value": 22000 }]
      }
    ]
  },
  "mixer": {
    "inserts": [
      { "id": "master" },
      { "id": "filtered", "effects": [{ "type": "builtin", "id": "lp", "kind": "lowpass", "params": { "frequency": 22000 } }] }
    ]
  }
}
